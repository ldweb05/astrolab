services:

  astro-dev-web:
    build: .
    container_name: astro-dev-web
    restart: unless-stopped
    ports:
      - "8090:80"
    volumes:
      - ./www:/var/www/html
      - ./php-config/php.ini:/usr/local/etc/php/php.ini
    env_file:
      - .env
    environment:
      - TZ=Europe/Rome
    depends_on:
      - astro-dev-db
    networks:
      - astro-dev-net

  astro-dev-db:
    image: postgres:16-alpine
    container_name: astro-dev-db
    restart: unless-stopped
    ports:
      - "5440:5432"
    volumes:
      - ./postgres-data:/var/lib/postgresql/data
    env_file:
      - .env
    environment:
      - TZ=Europe/Rome
    networks:
      - astro-dev-net

  astro-dev-adminer:
    image: adminer:latest
    container_name: astro-dev-adminer
    restart: unless-stopped
    ports:
      - "8091:8080"
    environment:
      - TZ=Europe/Rome
    depends_on:
      - astro-dev-db
    networks:
      - astro-dev-net

networks:
  astro-dev-net:
    driver: bridge
