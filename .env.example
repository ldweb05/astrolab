# .env.example
# Copiare in .env e valorizzare. NON committare mai .env con valori reali.

# ── Database PostgreSQL ─────────────────────────────
DB_HOST=astro-db
DB_PORT=5432
DB_NAME=astrologia
DB_USER=astro
DB_PASS=

# ── Ambiente applicativo ────────────────────────────
APP_ENV=development
APP_DEBUG=true

# ── Postgres container init (solo per docker-compose) ─
# Deve rimanere ALLINEATA a DB_USER/DB_PASS/DB_NAME sopra.
POSTGRES_USER=astro
POSTGRES_PASSWORD=
POSTGRES_DB=astrologia
